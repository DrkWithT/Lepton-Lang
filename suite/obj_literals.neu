`test structs`

trait Seq {
    next: fun (self) -> {
        def x = self.curr;

        self.curr += self.s;

        ret x;
    }
}

def makeSeq = fun (initial, step) -> new Seq {
    curr: initial,
    s: step
};

def iota = makeSeq(0, 1);

assert(iota.next() == 0, "Expected 0");
assert(iota.next() == 1, "Expected 1");
assert(iota.next() == 2, "Expected 2");
